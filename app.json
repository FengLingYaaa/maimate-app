{
  "expo": {
    "name": "MaiMate",
    "slug": "maimate-app",
    "version": "1.13.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f0f1a",
    "scheme": "maimate",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cc.flya.maimate",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["bilibili", "orpheus", "qqmusic", "kugou"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f0f1a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "cc.flya.maimate",
      "versionCode": 21,
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 MaiMate 读取用于识别曲名的照片",
          "cameraPermission": "允许 MaiMate 拍摄用于识别曲名的照片",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "./plugins/with-external-app-queries"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}